{
    "name": "manuxi/sulu-testimonials-bundle",
    "description": "Say hello to Sulu testimonials!",
    "type": "symfony-bundle",
    "keywords": [
        "sulu",
        "suluCms",
        "sulu bundle",
        "testimonials"
    ],
    "homepage": "https://github.com/manuxi/SuluTestimonialsBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Manuxi",
            "email": "manu@bytefresser.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/doctrine-bundle": "^2.13",
        "sulu/sulu": "^3.0",
        "symfony/config": "^6.4 | ^7.0",
        "symfony/dependency-injection": "^6.4 | ^7.0",
        "symfony/framework-bundle": "^6.4 | ^7.0",
        "symfony/http-foundation": "^6.4 | ^7.0",
        "symfony/http-kernel": "^6.4 | ^7.0",
        "symfony/intl": "^6.4 | ^7.0",
        "symfony/translation": "^6.4 | ^7.0",
        "symfony/security-core": "^6.4 | ^7.0",
        "twig/extra-bundle": "^3.23",
        "twig/intl-extra": "^3.23"
    },
    "require-dev": {
        "jackalope/jackalope-doctrine-dbal": "^1.3.4",
        "phpunit/phpunit": "^9.5 | ^10.0",
        "symfony/browser-kit": "^6.4 | ^7.0",
        "symfony/phpunit-bridge": "^6.4 | ^7.0",
        "symfony/console": "^6.4 | ^7.0",
        "phpspec/prophecy": "^1.17",
        "phpspec/prophecy-phpunit": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "Manuxi\\SuluTestimonialsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manuxi\\SuluTestimonialsBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@phpunit"
        ],
        "phpunit": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true
        },
        "minimum-stability": "stable",
        "prefer-stable": true
    }
}
