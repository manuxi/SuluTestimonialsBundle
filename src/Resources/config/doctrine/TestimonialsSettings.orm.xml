<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Manuxi\SuluTestimonialsBundle\Entity\TestimonialsSettings"
            table="app_testimonials_settings">

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <!-- AuditableTrait -->
        <field name="created" type="datetime_immutable" nullable="false"/>
        <field name="changed" type="datetime_immutable" nullable="false"/>

        <many-to-one field="creator" target-entity="Sulu\Component\Security\Authentication\UserInterface">
            <join-columns>
                <join-column name="creator_id" referenced-column-name="id" on-delete="SET NULL" nullable="true"/>
            </join-columns>
        </many-to-one>

        <many-to-one field="changer" target-entity="Sulu\Component\Security\Authentication\UserInterface">
            <join-columns>
                <join-column name="changer_id" referenced-column-name="id" on-delete="SET NULL" nullable="true"/>
            </join-columns>
        </many-to-one>

        <!-- Settings fields -->
        <field name="toggleHeader" type="boolean" nullable="true" column="toggle_header"/>
        <field name="toggleHero" type="boolean" nullable="true" column="toggle_hero"/>
        <field name="toggleBreadcrumbs" type="boolean" nullable="true" column="toggle_breadcrumbs"/>
        <field name="pageTestimonials" type="string" nullable="true" column="page_testimonials"/>

    </entity>
</doctrine-mapping>