<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>testimonials_versions</key>

    <joins name="dimensionContent">
        <join>
            <entity-name>dimensionContent</entity-name>
            <field-name>Manuxi\SuluTestimonialsBundle\Entity\Testimonial.dimensionContents</field-name>
            <method>INNER</method>
            <condition>dimensionContent.locale = :locale AND dimensionContent.stage = 'draft' AND dimensionContent.version > 0 AND Manuxi\SuluTestimonialsBundle\Entity\Testimonial.id = :id</condition>
        </join>
    </joins>

    <joins name="contact" ref="dimensionContent">
        <join>
            <entity-name>testimonialContact</entity-name>
            <field-name>dimensionContent.contact</field-name>
            <method>LEFT</method>
        </join>
    </joins>

    <joins name="changer">
        <join>
            <entity-name>%sulu.model.user.class%</entity-name>
            <field-name>dimensionContent.changer</field-name>
        </join>
        <join>
            <entity-name>%sulu.model.contact.class%</entity-name>
            <field-name>%sulu.model.user.class%.contact</field-name>
        </join>
    </joins>

    <properties>
        <property name="id" translation="sulu_admin.id" visibility="never">
            <field-name>id</field-name>
            <entity-name>Manuxi\SuluTestimonialsBundle\Entity\Testimonial</entity-name>
        </property>

        <property name="title" translation="sulu_admin.title" visibility="always" sortable="false">
            <field-name>title</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
            <transformer type="title"/>
        </property>

        <concatenation-property name="contact" glue=" " translation="sulu_testimonials.contact" visibility="always" sortable="false">
            <field>
                <field-name>firstName</field-name>
                <entity-name>testimonialContact</entity-name>
                <joins ref="contact"/>
            </field>
            <field>
                <field-name>lastName</field-name>
                <entity-name>testimonialContact</entity-name>
                <joins ref="contact"/>
            </field>
        </concatenation-property>

        <property name="rating" translation="sulu_testimonials.rating" visibility="always" sortable="false">
            <field-name>rating</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <property name="source" translation="sulu_testimonials.source" visibility="always" sortable="false">
            <field-name>source</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <property name="date" translation="sulu_testimonials.date" type="datetime" visibility="always" sortable="false">
            <field-name>date</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <property name="version" translation="sulu_admin.published" visibility="always" sortable="false">
            <field-name>version</field-name>
            <entity-name>dimensionContent</entity-name>
            <transformer type="datetime"/>
        </property>

        <concatenation-property name="changer" glue=" " translation="sulu_admin.changer" visibility="always" sortable="false">
            <field>
                <field-name>firstName</field-name>
                <entity-name>%sulu.model.contact.class%</entity-name>
                <joins ref="changer"/>
            </field>
            <field>
                <field-name>lastName</field-name>
                <entity-name>%sulu.model.contact.class%</entity-name>
                <joins ref="changer"/>
            </field>
        </concatenation-property>
    </properties>
</list>