{% extends "base.html.twig" %}

{% block content %}

    {% set name = "" %}
    {% set organisation = "" %}
    {% if testimonial.showContact|default and testimonial.contact is defined and testimonial.contact is not null %}
        {% set name = testimonial.contact.fullName|default('') %}
    {% endif %}
    {% if testimonial.showOrganisation|default and testimonial.contact is defined and testimonial.contact is not null %}
        {% if testimonial.contact.accountContacts is defined and testimonial.contact.accountContacts|length > 0 %}
            {% set organisation = testimonial.contact.accountContacts[0].account.name|default('') %}
        {% endif %}
    {% endif %}

    <div class="container">
        <div class="row">
            <div class="col-12 mb-3">
                <h2>{{ "sulu_testimonials.title"|trans({}, 'admin') }}: {{ testimonial.title }}</h2>

                <div class="media d-flex">
                    {% if testimonial.image is defined and testimonial.image is not null %}
                        {% set media = sulu_resolve_media(testimonial.image, app.request.locale) %}
                        {% set testimonialImage = media.thumbnails["sulu-240x"] %}
                        <img src="{{ asset(testimonialImage) }}" class="img-thumbnail d-block border shadow rounded" style="width:4rem;" alt="{{ testimonial.title }}">
                    {% endif %}
                    <div>
                        {% if testimonial.showContact|default and name is not empty %}
                            <p class="mb-0">
                                {{ name }}
                            </p>
                        {% endif %}
                        {% if testimonial.showOrganisation|default and organisation is not empty %}
                            <p class="mb-0">
                                {{ organisation }}
                            </p>
                        {% endif %}
                        {% if testimonial.showDate|default and testimonial.date is defined and testimonial.date is not null %}
                            <small class="text-muted">
                                {{ testimonial.date|format_datetime('medium', 'none', locale: app.request.locale) }}
                            </small>
                        {% endif %}
                    </div>
                </div>

                <p>{{ testimonial.text|raw }}</p>

                {% if testimonial.rating is defined %}
                    <div style="font-size:24px;color:#ccc;">
                        <span{% if testimonial.rating >= 1 %} style="color: gold;"{% endif %}>★</span>
                        <span{% if testimonial.rating >= 2 %} style="color: gold;"{% endif %}>★</span>
                        <span{% if testimonial.rating >= 3 %} style="color: gold;"{% endif %}>★</span>
                        <span{% if testimonial.rating >= 4 %} style="color: gold;"{% endif %}>★</span>
                        <span{% if testimonial.rating >= 5 %} style="color: gold;"{% endif %}>★</span>
                    </div>
                {% endif %}

                {% if testimonial.contact is defined and testimonial.contact is not null and testimonial.contact.avatar is defined and testimonial.contact.avatar is not null %}
                    {% set media = sulu_resolve_media(testimonial.contact.avatar, app.request.locale) %}
                    {% set image = media.thumbnails["sulu-50x50"] %}
                    <img src="{{ asset(image) }}" alt="{{ testimonial.contact.fullName|default('') }}">
                {% endif %}

            </div>
        </div>
    </div>
{% endblock %}
