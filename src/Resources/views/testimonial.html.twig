{% extends "base.html.twig" %}

{% block content %}
    <div class="container my-3">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        {# Header / Title #}
                        <h2 class="card-title h4 mb-3">{{ testimonial.title }}</h2>

                        <div class="d-flex align-items-start mb-4">
                            {# Testimonial Image #}
                            {% if testimonial.image is defined and testimonial.image is not null %}
                                {% set media = sulu_resolve_media(testimonial.image, app.request.locale) %}
                                {% if media is not null %}
                                    <div class="flex-shrink-0 me-3">
                                        <img src="{{ media.thumbnails['sulu-240x'] }}"
                                             class="img-fluid rounded shadow-sm"
                                             style="width: 80px; height: 80px; object-fit: cover;"
                                             alt="{{ testimonial.title }}">
                                    </div>
                                {% endif %}
                            {% endif %}

                            <div class="flex-grow-1">

                                {# Author / Contact Name #}
                                {% if testimonial.showContact|default and testimonial.contact|default %}
                                    <h5 class="mb-0">{{ testimonial.contact.fullName|default('') }}</h5>
                                {% endif %}

                                {# Organisation #}
                                {% if testimonial.showOrganisation|default and testimonial.contact is defined and testimonial.contact is not null %}
                                    {% if testimonial.contact.accountContacts is defined and testimonial.contact.accountContacts|length > 0 %}
                                        <div class="text-muted small">
                                            {{ testimonial.contact.accountContacts[0].account.name|default('') }}
                                        </div>
                                    {% endif %}
                                {% endif %}

                                {# Date #}
                                {% if testimonial.showDate|default and testimonial.date is defined and testimonial.date is not null %}
                                    <div class="text-muted small mt-1">
                                        <i class="su-calendar me-1"></i>
                                        {{ testimonial.date|format_datetime('medium', 'none', locale: app.request.locale) }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Quote Text #}
                        <div class="card-text mb-4 fst-italic position-relative ps-4 border-start border-4 border-primary">
                            {{ testimonial.text|raw }}
                        </div>

                        {# Rating #}
                        {% if testimonial.rating is defined and testimonial.rating > 0 %}
                            {% set ratingValue = testimonial.rating %}
                            {% set maxRating = 5 %}
                            {% set starValue = ratingValue %}

                            {% if ratingValue > 5 %}
                                {% set maxRating = 10 %}
                                {% set starValue = ratingValue / 2 %}
                            {% endif %}

                            {% set displayedRating = (starValue * 2)|round / 2 %}
                            <div class="d-flex align-items-center" aria-label="Rating: {{ ratingValue }}">
                                {% for i in 1..5 %}
                                    {% if displayedRating >= i %}
                                        <span class="fs-4" style="color: #ffc107;">★</span>
                                    {% elseif displayedRating >= i - 0.5 %}
                                        <div class="position-relative d-inline-block lh-1">
                                            <span class="fs-4 text-muted opacity-25">★</span>
                                            <span class="fs-4 position-absolute top-0 start-0 overflow-hidden" style="width: 50%; color: #ffc107;">★</span>
                                        </div>
                                    {% else %}
                                        <span class="fs-4 text-muted opacity-25">★</span>
                                    {% endif %}
                                {% endfor %}
                                <span class="ms-2 text-muted small">({{ ratingValue }}/{{ maxRating }})</span>
                            </div>
                        {% endif %}
                        {#
                        {% if testimonial.rating is defined and testimonial.rating > 0 %}
                            <div class="d-flex align-items-center" style="color: #ffc107;" aria-label="Rating: {{ testimonial.rating }}">
                                {% set maxRating = 5 %}
                                {% if testimonial.rating > 5 %}{% set maxRating = 10 %}{% endif %}

                                {% for i in 1..maxRating %}
                                    {% if testimonial.rating >= i %}
                                        <i class="fs-4">★</i>
                                    {% else %}
                                        <i class="fs-4 text-muted opacity-25">★</i>
                                    {% endif %}
                                {% endfor %}
                                <span class="ms-2 text-muted small">({{ testimonial.rating }}/{{ maxRating }})</span>
                            </div>
                        {% endif %}
                        #}
                    </div>

                    {# Footer / Avatar of Contact #}
                    {% if testimonial.contact is defined and testimonial.contact is not null and testimonial.contact.avatar is defined and testimonial.contact.avatar is not null %}
                        <div class="card-footer bg-light d-flex align-items-center">
                            {% set avatarMedia = sulu_resolve_media(testimonial.contact.avatar, app.request.locale) %}
                            {% if avatarMedia is not null %}
                                <img src="{{ avatarMedia.thumbnails['sulu-50x50'] }}"
                                     class="rounded-circle me-2 border border-white shadow-sm"
                                     width="30" height="30"
                                     alt="{{ testimonial.contact.fullName|default('') }}">
                                <span class="small text-muted">{{ "sulu_testimonials.verified"|trans }}</span>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
